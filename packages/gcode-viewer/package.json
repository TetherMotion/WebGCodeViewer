{
  "name": "@tether/gcode-viewer",
  "version": "1.0.0",
  "description": "Tether viewer gcode-viewer package",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./GcodeViewer": {
      "import": "./src/GcodeViewer.ts",
      "types": "./src/GcodeViewer.ts"
    },
    "./BookmarkManager": {
      "import": "./src/BookmarkManager.ts",
      "types": "./src/BookmarkManager.ts"
    },
    "./SegmentList": {
      "import": "./src/SegmentList.ts",
      "types": "./src/SegmentList.ts"
    },
    "./AttributePanel": {
      "import": "./src/AttributePanel.ts",
      "types": "./src/AttributePanel.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "jsdom": "^24.0.0",
    "@webgpu/types": "^0.1.71"
  },
  "dependencies": {
    "@tether/viewer-core": "*",
    "@bufbuild/protobuf": "^2.14.0"
  }
}
