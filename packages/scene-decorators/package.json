{
  "name": "@tether/scene-decorators",
  "version": "1.0.0",
  "description": "Tether viewer scene-decorators package",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./PrintHeadMarker": {
      "import": "./src/PrintHeadMarker.ts",
      "types": "./src/PrintHeadMarker.ts"
    },
    "./PrinterFrameRenderer": {
      "import": "./src/PrinterFrameRenderer.ts",
      "types": "./src/PrinterFrameRenderer.ts"
    },
    "./ToolChangeMarkerRenderer": {
      "import": "./src/ToolChangeMarkerRenderer.ts",
      "types": "./src/ToolChangeMarkerRenderer.ts"
    },
    "./OverlayRenderer": {
      "import": "./src/OverlayRenderer.ts",
      "types": "./src/OverlayRenderer.ts"
    },
    "./MeasureTool": {
      "import": "./src/MeasureTool.ts",
      "types": "./src/MeasureTool.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "jsdom": "^24.0.0",
    "@webgpu/types": "^0.1.71"
  },
  "dependencies": {
    "@tether/viewer-core": "*"
  }
}
