{
  "name": "@tether/tthr-renderer",
  "version": "1.0.0",
  "description": "Tether TTHR point/line renderer for sampled trajectory data",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
