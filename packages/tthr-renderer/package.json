    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "jsdom": "^24.0.0",
    "@webgpu/types": "^0.1.71"
  },
  "dependencies": {
    "@tether/viewer-core": "*"
  }
}
